# ══════════════════════════════════════════════════════════════════════════
# Backend unificado Ommex — plantilla de configuración (sin secretos)
# Copia este archivo a `.env` y rellena los valores reales.
# ══════════════════════════════════════════════════════════════════════════

# ── Servidor ──
PORT=4000

# ── MongoDB (un solo clúster Atlas para los 3 dominios) ──
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_TURNOS=ommex_register
MONGODB_DB_TRAZABILIDAD=pluscargo_logging
MONGODB_DB_ACADEMIA=ommex_academia

# ── Autenticación ──
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
AUTH_TOKEN_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ── Turnos ──
APPS_SCRIPT_DB_URL=
APP_PUBLIC_URL=http://localhost:5173
TRACER_API_URL=
WEBAUTHN_RP_NAME=Ommex Turnos
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
FACE_SERVICE_URL=

# ── Trazabilidad ──
TURNOS_API_URL=
ENABLE_AUTO_CLEANUP=false
GAS_WEBHOOK_URL=
DRIVE_FOLDER_ID=
DRIVE_PARENT_FOLDER_ID=

# ── WhatsApp ──
ENABLE_WHATSAPP_TURNOS=false
ENABLE_WHATSAPP_WEB=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_CONTENT_SID=

# ── Almacenamiento (Cloudflare R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL=604800

# ── GitHub Storage (trazabilidad) ──
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# ── Email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
